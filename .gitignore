!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Builds / caches (jamais dans Git) ---
dist/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.turbo/
.parcel-cache/
.vite/
coverage/
