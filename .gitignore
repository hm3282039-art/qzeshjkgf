.DS_Store
Thumbs.db
*.log
npm-debug.log*
.env
.env.*
!.env.example
.vscode/*
!.vscode/extensions.json
.idea/

# --- Sources d'art / audio lourdes (les exports optimisés vont sur le CDN) ---
